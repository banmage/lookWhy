{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://leleby.io/schema/audit-rule-set-1.0.json",
  "title": "Leleby Audit Rule Set",
  "type": "object",
  "required": ["schema-version", "kind", "id", "version", "title", "rules", "execution-policy"],
  "properties": {
    "schema-version": {"const": "1.0"},
    "kind": {"const": "audit-rule-set"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "candidate", "approved", "retired"]},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "source": {"type": "object"},
    "applicability": {"type": "object"},
    "execution-policy": {
      "type": "object",
      "required": ["conversion", "unknown-rule-result", "result-states"],
      "properties": {
        "conversion": {"const": "never-block"},
        "unknown-rule-result": {"const": "unresolved"},
        "default-severity": {"enum": ["info", "warning", "error", "critical"]},
        "result-states": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      },
      "additionalProperties": true
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "category", "requirement", "target", "check", "severity", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "requirement": {"type": "object", "required": ["obligation", "applicability", "statement"]},
          "target": {"type": "object", "required": ["scope", "path"]},
          "check": {"type": "object", "required": ["operator"]},
          "severity": {"enum": ["info", "warning", "error", "critical"]},
          "evidence": {"type": "object", "required": ["required", "kind"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
