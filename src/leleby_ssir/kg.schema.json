{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://leleby.io/schemas/kg/v0.1.schema.json",
  "title": "leleby KG slice schema v0.1",
  "description": "SSIR→KG 图切片（kg.json）契约 v0.1：每文档一份，节点主键复用 SSIR 稳定 URI；边类型见 kg.py 文档。节点/边之外字段一律透传，允许扩展属性（additionalProperties: true），本 schema 只钉必填与结构。",
  "type": "object",
  "required": ["kgVersion", "document", "nodes", "edges"],
  "properties": {
    "kgVersion": { "type": "string", "enum": ["0.1"] },
    "document": {
      "type": "object",
      "required": ["standardNumber", "rootNodeId"],
      "properties": {
        "id": { "type": "string" },
        "rootNodeId": { "type": "string" },
        "standardNumber": { "type": "string" },
        "chineseTitle": { "type": "string" },
        "documentType": { "type": "string" },
        "ics": { "type": "string" },
        "ccs": { "type": "string" },
        "replaces": { "type": "string" },
        "issuer": { "type": "string" },
        "publicationDate": { "type": "string" },
        "effectiveDate": { "type": "string" },
        "sourceFileName": { "type": "string" },
        "artifactPath": { "type": "string" },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["standardNumber", "norm"],
            "properties": {
              "standardNumber": { "type": "string" },
              "norm": { "type": "string" },
              "clause": { "type": ["string", "null"] },
              "mdLine": { "type": ["integer", "null"] }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["Document", "DocumentBlock", "Clause", "Annex",
                     "ContentUnit", "Term", "Table", "Figure", "Formula"]
          },
          "number": { "type": ["string", "null"] },
          "title": { "type": ["string", "null"] },
          "term": { "type": "string" },
          "englishTerm": { "type": "string" },
          "definitionText": { "type": "string" },
          "clauseNumber": { "type": ["string", "null"] },
          "clauseTitle": { "type": ["string", "null"] },
          "structuralKind": { "type": "string" },
          "presentationType": { "type": "string" },
          "depth": { "type": "integer" },
          "text": { "type": "string" },
          "truncated": { "type": "boolean" },
          "semantics": { "type": "array", "items": { "type": "string" } },
          "caption": { "type": ["string", "null"] },
          "assetRef": { "type": ["string", "null"] },
          "anchor": {
            "type": "object",
            "properties": {
              "markdownStartLine": { "type": ["integer", "null"] },
              "markdownEndLine": { "type": ["integer", "null"] },
              "markdownNodePath": { "type": ["string", "null"] },
              "sourceFileId": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "type"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["HAS_CHILD", "CONTAINS_ELEMENT", "HAS_TERM"]
          }
        },
        "additionalProperties": true
      }
    },
    "counts": { "type": "object", "additionalProperties": { "type": "integer" } }
  },
  "additionalProperties": true
}
